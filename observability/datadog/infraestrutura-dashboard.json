{
  "title": "Oficina Mecânica — Infraestrutura",
  "description": "Ambiente development. Definição versionada no repositório Kubernetes; grupos por serviço. Importação não substitui validação de ingestão.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "Recursos Kubernetes por serviço e disponibilidade da plataforma. CPU e memória usam as unidades nativas do Datadog. Sem dados não significa saudável. Métricas de RDS/SQS dependem de integração AWS e não estão representadas neste painel."
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "OS / API",
        "layout_type": "ordered",
        "show_title": true,
        "background_color": "white",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU",
              "show_legend": true,
              "requests": [
                {
                  "q": "sum:kubernetes.cpu.usage.total{env:development,kube_deployment:oficina-mecanica-api} by {kube_deployment}",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memória",
              "show_legend": true,
              "requests": [
                {
                  "q": "sum:kubernetes.memory.usage{env:development,kube_deployment:oficina-mecanica-api} by {kube_deployment}",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Réplicas desejadas e disponíveis",
              "show_legend": true,
              "requests": [
                {
                  "q": "max:kubernetes_state.deployment.replicas_desired{env:development,kube_deployment:oficina-mecanica-api} by {kube_deployment}",
                  "display_type": "line"
                },
                {
                  "q": "max:kubernetes_state.deployment.replicas_available{env:development,kube_deployment:oficina-mecanica-api} by {kube_deployment}",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Reinícios por Pod",
              "show_legend": true,
              "requests": [
                {
                  "q": "max:kubernetes.containers.restarts{env:development,kube_deployment:oficina-mecanica-api} by {pod_name,kube_container_name}",
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 2,
