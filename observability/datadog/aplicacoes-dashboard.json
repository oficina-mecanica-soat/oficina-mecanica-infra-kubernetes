                    "data_source": "logs_stream",
                    "query_string": "env:development service:oficina-mecanica-api @Properties.SourceContext:(Microsoft* OR System*) @Level:(Warning OR Error OR Fatal)",
                    "sort": {
                      "column": "timestamp",
                      "order": "desc"
                    }
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 3
            }
          }
        ]
